# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

NEXT_PUBLIC_CONVEX_URL=

# Azure AI credentials - stored in Convex env vars
# Run: npx convex env set AZURE_AI_API_KEY "your-key"
# Run: npx convex env set AZURE_AI_ENDPOINT "your-endpoint"
# Run: npx convex env set AZURE_AI_MODEL "gpt-4o-mini"
