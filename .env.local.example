# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

NEXT_PUBLIC_CONVEX_URL=

# OpenAI - stored in Convex env vars
# Run: npx convex env set OPENAI_API_KEY "sk-xxxxx"

# Tavily API for web search - stored in Convex env vars
# Get API key from https://tavily.com (free tier: 1000 searches/month)
# Run: npx convex env set TAVILY_API_KEY "tvly-xxxxx"
